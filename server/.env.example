# Copy to .env and adjust.
# SQLite for local dev (zero setup). For Postgres, change schema.prisma
# provider to "postgresql" and set a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Sign JWTs. MUST be set to a long random value in production.
JWT_SECRET="dev-only-insecure-secret-change-me"

PORT=4000

# Optional device integrations (leave unset to use sample imports only).
# HAWKIN_API_TOKEN=""
# OVR_API_KEY=""
