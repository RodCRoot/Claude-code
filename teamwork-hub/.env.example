# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://teamwork:teamwork@localhost:5432/teamwork_hub
TEST_DATABASE_URL=postgres://teamwork:teamwork@localhost:5432/teamwork_hub_test
SESSION_SECRET=replace-with-64-random-hex-characters-generated-locally-xxxxxxx
APP_URL=http://localhost:3000
# demo | staging | production. demo enables synthetic data + dev role switcher.
APP_MODE=demo

# Object storage. local = files under STORAGE_DIR (needs a persistent disk in staging/production);
# s3 = private S3-compatible bucket with server-side encryption.
STORAGE_BACKEND=local
STORAGE_DIR=./.storage
S3_BUCKET=
S3_REGION=
# Only for S3-compatible providers (Cloudflare R2, Backblaze B2, MinIO); leave empty for AWS.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, e.g. "staging".
S3_PREFIX=
# AES256 (SSE-S3, default) | aws:kms (set S3_KMS_KEY_ID) | none (only for providers that reject the header)
S3_SSE=AES256
S3_KMS_KEY_ID=
# Bucket credentials come from the standard AWS chain, e.g.:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Payments (sandbox keys only during the build)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Hawkin Dynamics Cloud API (server-side only)
HAWKIN_REFRESH_TOKEN=
HAWKIN_API_BASE=https://cloud.hawkindynamics.com/api
HAWKIN_ORG_SCOPE=

# Google Calendar OAuth (Web application client). Authorized redirect URI:
#   ${APP_URL}/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored OAuth tokens (AES-256-GCM).
# Changing it makes existing tokens unreadable; coaches then reconnect.
CALENDAR_TOKEN_KEY=

# Messaging. External delivery stays off unless DELIVERY_ENABLED=true.
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=none
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=
DELIVERY_ENABLED=false
DELIVERY_TEST_RECIPIENTS=
# GoHighLevel / LeadConnector (API v2, https://services.leadconnectorhq.com). Set SMS_PROVIDER=gohighlevel
# to send SMS through GHL instead of Twilio (still requires DELIVERY_ENABLED=true). Use a sub-account
# Private Integration Token with scopes conversations/message.write and contacts.readonly.
# SMS goes only to contacts that already exist in GHL (looked up by phone); none are created.
GHL_API_KEY=
GHL_LOCATION_ID=
# Optional sender number (E.164); GHL's sub-account default is used when empty.
GHL_FROM_NUMBER=
# Provider webhooks (see docs/modules/crm-messaging.md → Provider setup). Without these the
# endpoints reject every request (recorded, never trusted).
# HTTP Basic password for Postmark webhooks + SendGrid Inbound Parse (>= 16 chars).
EMAIL_WEBHOOK_SECRET=
# SendGrid Signed Event Webhook verification key (Mail Settings → Event Webhook → Signature).
SENDGRID_WEBHOOK_PUBLIC_KEY=
# Inbound email domain; outbound email gets Reply-To reply+<token>@this-domain when set.
EMAIL_INBOUND_DOMAIN=
# Twilio inbound SMS / STOP replies are verified with SMS_AUTH_TOKEN above.

# Monitoring. Logs are always structured JSON with secrets/emails/health fields redacted.
# Sentry (server + worker only) turns on only when SENTRY_DSN is set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 0 = errors only (default); 0.1 = sample 10% of requests for performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0
# debug | info | warn | error
LOG_LEVEL=info
